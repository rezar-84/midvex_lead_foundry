# Production template for mlf.midvex.com — copy values into Dokploy's
# environment configuration. Never commit a populated copy.

DJANGO_DEBUG=false
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=mlf.midvex.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://mlf.midvex.com

FOUNDRY_BRAND_NAME=Midvex Lead Foundry
FOUNDRY_USER_AGENT=MidvexLeadFoundry/0.1 (+private research; contact operator)
DJANGO_LANGUAGE_CODE=en
DJANGO_LANGUAGES=en=English,tr=Türkçe
DJANGO_TIME_ZONE=Europe/Istanbul

DATABASE_URL=postgresql://lead_foundry:replace-me@postgres:5432/lead_foundry
DATABASE_SSLMODE=prefer
POSTGRES_PASSWORD=replace-me
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key

# Evidence storage. Single-node default: the compose evidence volume.
# For S3-compatible object storage set RAW_STORAGE_BACKEND=s3 and the S3_* values.
RAW_STORAGE_BACKEND=filesystem
RAW_STORAGE_ROOT=/data/evidence
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Gmail OAuth (only needed once real-mailbox work is approved — MVX-009).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://mlf.midvex.com/sources/gmail/callback/

# Policy gates: keep false until the corresponding human approvals are recorded.
GMAIL_REAL_DATA_ENABLED=false
SOURCE_NETWORK_ENABLED=false
ENRICHMENT_NETWORK_ENABLED=false
ENRICHMENT_EGRESS_PROXY=
